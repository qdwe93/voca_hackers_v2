{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-set.schema.json",
  "title": "mid1st author sentence candidate set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "author", "day", "range", "set", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "author": { "enum": ["codex", "antigravity", "claude"] },
    "day": { "type": "integer", "minimum": 1, "maximum": 30 },
    "range": { "type": "string", "pattern": "^(0[1-9]|[1-3][0-9]|40)-(0[1-9]|[1-3][0-9]|40)$" },
    "set": { "type": "integer", "minimum": 1, "maximum": 4 },
    "items": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wordId", "no", "word", "sentence"],
        "properties": {
          "wordId": { "type": "string", "pattern": "^DAY(0[1-9]|[12][0-9]|30)-(0[1-9]|[1-3][0-9]|40)$" },
          "no": { "type": "integer", "minimum": 1, "maximum": 40 },
          "word": { "type": "string", "minLength": 1 },
          "sentence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
